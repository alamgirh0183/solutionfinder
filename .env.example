NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase key for Stripe webhooks, aggregate analytics, and public-search protection.
# Never prefix this with NEXT_PUBLIC_ or expose it in browser code.
SUPABASE_SECRET_KEY=your-supabase-secret-key
PUBLIC_SEARCH_RATE_LIMIT_SECRET=replace-with-a-long-random-server-only-secret
PUBLIC_SEARCH_LIMIT_PER_HOUR=20

# Optional HTTPS n8n webhook URLs. Keep these server-side.
N8N_FEEDBACK_WEBHOOK_URL=https://your-n8n-host/webhook/solution-feedback
N8N_WAITLIST_WEBHOOK_URL=https://your-n8n-host/webhook/solutionfinder-waitlist

# Stripe test mode only. Use a test-mode Price ID and the webhook signing secret
# from `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
STRIPE_PREMIUM_PRICE_ID=price_your_stripe_test_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_test_webhook_secret
